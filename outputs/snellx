#!/usr/bin/env bash
#
# snellx - interactive manager for the Snell v6 installation created by snell-v6.sh
#
# Install:
#   install -o root -g root -m 0755 snellx /usr/local/sbin/snellx
#
# Usage:
#   snellx
#   snellx status|show|update|restart|psk|port|logs|timer|channel|check|uninstall

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

readonly CONFIG_PATH="/etc/snell-server/snell-server.conf"
readonly STATE_DIR="/var/lib/snell-server"
readonly PORT_STATE="${STATE_DIR}/port"
readonly RELEASE_STATE="${STATE_DIR}/release"
readonly MANAGER_PATH="/usr/local/sbin/snell-manager"
readonly SERVICE_NAME="snell-server.service"
readonly TIMER_NAME="snell-update.timer"
readonly LOCK_FILE="/run/lock/snell-manager.lock"
readonly NETWORK_TOOL="/usr/local/sbin/snell-net"
readonly SECURITY_TOOL="/usr/local/sbin/snell-security"
readonly AUTO_TOOL="/usr/local/sbin/snell-auto"
readonly NETWORK_STATE="/var/lib/snell-net"
readonly SECURITY_STATE="/var/lib/snell-security"
readonly MENU_MARKER="# snellx - interactive manager for the Snell v6 installation created by snell-v6.sh"

LOCK_HELD=0
LAST_BACKUP=""

if [[ -t 1 ]]; then
  readonly C_RESET=$'\033[0m'
  readonly C_BOLD=$'\033[1m'
  readonly C_GREEN=$'\033[32m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_RED=$'\033[31m'
  readonly C_CYAN=$'\033[36m'
else
  readonly C_RESET=""
  readonly C_BOLD=""
  readonly C_GREEN=""
  readonly C_YELLOW=""
  readonly C_RED=""
  readonly C_CYAN=""
fi

info() {
  printf '%s[信息]%s %s\n' "$C_CYAN" "$C_RESET" "$*"
}

ok() {
  printf '%s[成功]%s %s\n' "$C_GREEN" "$C_RESET" "$*"
}

warn() {
  printf '%s[警告]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2
}

die() {
  printf '%s[错误]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2
  exit 1
}

cleanup() {
  if [[ "$LOCK_HELD" -eq 1 ]]; then flock -u 9 || true; fi
}
trap cleanup EXIT

require_root() {
  [[ "$EUID" -eq 0 ]] || die "请使用 root 运行：sudo snellx"
}

require_systemd() {
  command -v systemctl >/dev/null 2>&1 || die "未检测到 systemd。"
  [[ -d /run/systemd/system ]] || die "systemd 当前未作为 init 系统运行。"
}

require_installation() {
  [[ -f "$CONFIG_PATH" ]] || die "未找到配置：${CONFIG_PATH}"
  [[ -x /usr/local/bin/snell-server ]] || die "未找到 Snell 程序：/usr/local/bin/snell-server"
  systemctl cat "$SERVICE_NAME" >/dev/null 2>&1 || die "未找到 ${SERVICE_NAME}。"
}

acquire_lock() {
  install -d -m 0755 /run/lock
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "另一个安装、升级或配置任务正在运行。"
  LOCK_HELD=1
}

release_lock() {
  if [[ "$LOCK_HELD" -eq 1 ]]; then flock -u 9 || true; fi
  LOCK_HELD=0
}

pause_screen() {
  [[ -t 0 ]] || return 0
  printf '\n按 Enter 返回菜单……'
  read -r _unused
}

confirm() {
  local prompt="$1"
  local answer=""
  read -r -p "${prompt} [y/N]: " answer
  [[ "$answer" == "y" || "$answer" == "Y" ]]
}

config_value() {
  local key="$1"
  awk -v wanted="$key" '
    /^[[:space:]]*[#;]/ { next }
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (index(line, wanted) == 1) {
        rest = substr(line, length(wanted) + 1)
        if (rest ~ /^[[:space:]]*=/) {
          sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
          sub(/[[:space:]]*$/, "", rest)
          print rest
          exit
        }
      }
    }
  ' "$CONFIG_PATH"
}

current_port() {
  local listen_value
  listen_value="$(config_value listen)"
  printf '%s\n' "$listen_value" |
    grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}|\[[^]]+\]:[0-9]{1,5}' |
    sed -n '1 { s/.*://; p; }'
}

public_ip() {
  local ip=""
  if command -v curl >/dev/null 2>&1; then
    ip="$(curl -4 -fsS --connect-timeout 3 --max-time 6 https://ifconfig.me/ip 2>/dev/null || true)"
  fi
  if [[ ! "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    ip="<VPS公网IP>"
  fi
  printf '%s\n' "$ip"
}

generate_psk() {
  od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
  printf '\n'
}

port_is_free() {
  local port="$1"
  local listeners
  listeners="$(ss -H -ltn)" || die "无法检查监听端口。"
  ! printf '%s\n' "$listeners" | awk '{ print $4 }' |
    grep -Eq "(^|:|\\])${port}$"
}

port_is_listening() {
  local port="$1" pid
  pid="$(systemctl show "$SERVICE_NAME" -p MainPID --value)" || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  ss -H -ltnp | awk -v port="$port" -v pid="$pid" '
    $4 ~ (":" port "$") && index($0, "pid=" pid ",") { found=1 }
    END { exit !found }
  '
}

wait_for_port() {
  local port="$1"
  local _
  for _ in $(seq 1 10); do
    if port_is_listening "$port"; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

ephemeral_port_range() {
  local low=0 high=0
  if [[ -r /proc/sys/net/ipv4/ip_local_port_range ]]; then
    IFS=$' \t' read -r low high < /proc/sys/net/ipv4/ip_local_port_range || true
  fi
  [[ "$low" =~ ^[0-9]+$ && "$high" =~ ^[0-9]+$ ]] || { low=0; high=0; }
  printf '%s %s\n' "$low" "$high"
}

# Same policy as the installer: 10000-65000, outside the ephemeral range.
generate_port() {
  local port low high avoid=1
  local _
  IFS=' ' read -r low high < <(ephemeral_port_range)
  if (( low <= 10000 && high >= 65000 )); then avoid=0; fi
  for _ in $(seq 1 400); do
    port="$((10000 + (10#$(od -An -N2 -tu2 /dev/urandom | tr -d ' ') % 55001)))"
    if (( avoid && port >= low && port <= high )); then continue; fi
    if port_is_free "$port"; then
      printf '%s\n' "$port"
      return 0
    fi
  done
  return 1
}

backup_config() {
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  LAST_BACKUP="$(mktemp "${CONFIG_PATH}.bak.${stamp}.XXXXXX")" || die "无法创建配置备份。"
  cp -a -- "$CONFIG_PATH" "$LAST_BACKUP" || die "配置备份失败，未修改配置。"
  info "配置已备份：${LAST_BACKUP}"
  prune_config_backups
}

# Keep the newest five config backups (they contain the PSK). Names embed a
# timestamp, so name order is creation order; cp -a keeps the old mtime.
prune_config_backups() {
  local old
  while IFS= read -r old; do
    [[ "$old" == "${CONFIG_PATH}.bak."* && ! -L "$old" ]] && rm -f -- "$old"
  done < <(find "$(dirname "$CONFIG_PATH")" -maxdepth 1 -type f -name "$(basename "$CONFIG_PATH").bak.*" -printf '%f\t%p\n' 2>/dev/null |
    LC_ALL=C sort -r | awk -F '\t' 'NR > 5 { print $2 }')
  return 0
}

restore_backup() {
  [[ -n "$LAST_BACKUP" && -f "$LAST_BACKUP" ]] || return 1
  cp -a -- "$LAST_BACKUP" "$CONFIG_PATH" || return 1
  chown root:snell "$CONFIG_PATH" || return 1
  chmod 0640 "$CONFIG_PATH" || return 1
}

replace_config_key() {
  local key="$1"
  local value="$2"
  local tmp
  tmp="$(mktemp "${CONFIG_PATH}.tmp.XXXXXX")" || die "无法创建临时配置。"

  awk -v wanted="$key" -v replacement="$value" '
    BEGIN { changed = 0 }
    {
      line = $0
      trimmed = line
      sub(/^[[:space:]]*/, "", trimmed)
      if (!changed && index(trimmed, wanted) == 1) {
        rest = substr(trimmed, length(wanted) + 1)
        if (rest ~ /^[[:space:]]*=/) {
          print wanted " = " replacement
          changed = 1
          next
        }
      }
      print line
    }
    END {
      if (!changed) {
        print wanted " = " replacement
      }
    }
  ' "$CONFIG_PATH" > "$tmp" || die "生成新配置失败，原配置未替换。"

  chown root:snell "$tmp" || die "设置配置所有者失败。"
  chmod 0640 "$tmp" || die "设置配置权限失败。"
  mv -f -- "$tmp" "$CONFIG_PATH" || die "替换配置失败。"
}

replace_listen_port() {
  local old_port="$1"
  local new_port="$2"
  local listen_value
  listen_value="$(config_value listen)"
  [[ -n "$listen_value" ]] || die "无法读取 listen 配置。"

  listen_value="$(
    printf '%s\n' "$listen_value" |
      sed -E "s/:${old_port}([,[:space:]]|$)/:${new_port}\\1/g"
  )"
  replace_config_key "listen" "$listen_value"
}

firewall_backend() {
  # Capture first: with pipefail, "ufw status | grep -q" can fail via SIGPIPE.
  if command -v ufw >/dev/null 2>&1 && grep -q '^Status: active' <<< "$(ufw status 2>/dev/null)"; then
    printf 'ufw\n'
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    printf 'firewalld\n'
  else
    printf 'none\n'
  fi
}

firewall_allow() {
  local port="$1"
  case "$(firewall_backend)" in
    ufw)
      ufw allow "${port}/tcp" comment 'Snell v6' >/dev/null
      ;;
    firewalld)
      firewall-cmd --add-port="${port}/tcp" >/dev/null || return 1
      firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null
      ;;
    none)
      warn "未检测到已启用的 UFW/firewalld，请确认服务商防火墙已放行 TCP ${port}。"
      ;;
  esac
}

firewall_delete() {
  local port="$1"
  case "$(firewall_backend)" in
    ufw)
      ufw --force delete allow "${port}/tcp" >/dev/null 2>&1 || true
      ;;
    firewalld)
      firewall-cmd --remove-port="${port}/tcp" >/dev/null 2>&1 || true
      firewall-cmd --permanent --remove-port="${port}/tcp" >/dev/null 2>&1 || true
      ;;
  esac
}

restart_with_rollback() {
  local description="$1"
  if systemctl restart "$SERVICE_NAME" && sleep 2 && systemctl is-active --quiet "$SERVICE_NAME" && wait_for_port "$(current_port)"; then
    ok "${description}成功，Snell 已正常运行。"
    return 0
  fi

  warn "${description}后服务启动失败，正在恢复上一份配置。"
  restore_backup || die "自动回滚失败，请从备份手动恢复：${LAST_BACKUP}"
  systemctl restart "$SERVICE_NAME" || true
  { systemctl is-active --quiet "$SERVICE_NAME" && wait_for_port "$(current_port)"; } ||
    die "已恢复配置，但服务仍未启动。请运行：journalctl -u ${SERVICE_NAME} -n 80 --no-pager"
  die "新配置不可用，已自动回滚。"
}

show_status() {
  local port
  local release="unknown"
  local service_state
  local timer_state
  port="$(current_port || true)"
  [[ -f "$RELEASE_STATE" ]] && release="$(<"$RELEASE_STATE")"
  service_state="$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)"
  timer_state="$(systemctl is-active "$TIMER_NAME" 2>/dev/null || true)"

  printf '%sSnell v6 状态%s\n' "$C_BOLD" "$C_RESET"
  printf '  版本：%s\n' "$release"
  printf '  服务：%s\n' "$service_state"
  printf '  端口：%s\n' "${port:-unknown}"
  printf '  自动升级：%s\n' "$timer_state"
  printf '  配置：%s\n' "$CONFIG_PATH"
  if [[ -n "$port" ]]; then
    printf '  监听：\n'
    ss -ltnp 2>/dev/null | awk -v port="$port" '$4 ~ (":" port "$") { print "    " $0 }'
  fi
}

show_connection() {
  warn "下方包含 PSK，请勿截图或公开转发。"
  if [[ -x "$MANAGER_PATH" ]]; then
    "$MANAGER_PATH" show
    return
  fi

  local ip
  local port
  local psk
  ip="$(public_ip)"
  port="$(current_port)"
  psk="$(config_value psk)"
  printf '服务器：%s\n端口：%s\nPSK：%s\n' "$ip" "$port" "$psk"
  printf 'Surge：Snell-v6 = snell, %s, %s, psk=%s, version=6\n' "$ip" "$port" "$psk"
}

update_snell() {
  local port
  [[ -x "$MANAGER_PATH" ]] || die "未找到 ${MANAGER_PATH}，无法安全更新。"
  info "正在检查官方 Snell v6 更新……"
  "$MANAGER_PATH" update || die "更新失败，查看上方错误。"
  port="$(current_port)"
  systemctl is-active --quiet "$SERVICE_NAME" || die "更新后 Snell 服务未运行。"
  wait_for_port "$port" || die "更新后服务未监听 TCP ${port}。"
  ok "更新检查完成。"
}

restart_snell() {
  local port
  port="$(current_port)"
  acquire_lock
  systemctl restart "$SERVICE_NAME" || die "Snell 重启失败。"
  sleep 2
  systemctl is-active --quiet "$SERVICE_NAME" || die "重启失败，请查看日志。"
  wait_for_port "$port" || die "重启后服务未监听 TCP ${port}。"
  release_lock
  ok "Snell 已重启。"
}

change_psk() {
  local choice=""
  local new_psk=""
  local confirm_psk=""

  printf '\n1) 自动生成安全 PSK\n2) 手动输入 PSK\n0) 取消\n'
  read -r -p "请选择 [1]: " choice
  choice="${choice:-1}"
  case "$choice" in
    1)
      new_psk="$(generate_psk)"
      ;;
    2)
      read -r -s -p "输入新 PSK（12–255 位字母、数字或 ._~+-）: " new_psk
      printf '\n'
      read -r -s -p "再次输入新 PSK: " confirm_psk
      printf '\n'
      [[ "$new_psk" == "$confirm_psk" ]] || die "两次输入不一致。"
      ;;
    0)
      info "已取消。"
      return 0
      ;;
    *)
      die "无效选择。"
      ;;
  esac

  [[ ${#new_psk} -ge 12 && ${#new_psk} -le 255 ]] || die "PSK 长度必须为 12–255 字符。"
  [[ "$new_psk" =~ ^[A-Za-z0-9._~+-]+$ ]] ||
    die "PSK 只能包含字母、数字或 . _ ~ + -。"

  warn "修改 PSK 后，所有客户端都必须同步更新。"
  confirm "确认修改 PSK？" || {
    info "已取消。"
    return 0
  }

  acquire_lock
  backup_config
  replace_config_key "psk" "$new_psk"
  restart_with_rollback "修改 PSK"
  release_lock
  show_connection
}

change_port() {
  local old_port
  local new_port=""
  local backend
  old_port="$(current_port)"

  read -r -p "输入新端口（留空自动生成，当前 ${old_port}）: " new_port
  if [[ -z "$new_port" ]]; then
    new_port="$(generate_port)" || die "无法自动找到空闲端口。"
    info "已选择空闲端口：${new_port}"
  fi

  [[ "$new_port" =~ ^[0-9]+$ ]] || die "端口必须是数字。"
  (( new_port >= 1024 && new_port <= 65535 )) || die "端口范围必须是 1024–65535。"
  [[ "$new_port" != "$old_port" ]] || {
    info "新旧端口相同，无需修改。"
    return 0
  }
  port_is_free "$new_port" || die "端口 ${new_port} 已被占用。"

  warn "修改端口后，所有客户端和服务商防火墙都必须同步更新。"
  confirm "确认把端口从 ${old_port} 改为 ${new_port}？" || {
    info "已取消。"
    return 0
  }

  acquire_lock
  backup_config
  backend="$(firewall_backend)"
  firewall_allow "$new_port" || die "防火墙放行失败，未修改 Snell 配置。"
  replace_listen_port "$old_port" "$new_port"

  if ! systemctl restart "$SERVICE_NAME" ||
    ! systemctl is-active --quiet "$SERVICE_NAME" ||
    ! wait_for_port "$new_port"; then
    warn "新端口启动失败，正在回滚。"
    restore_backup || die "自动回滚失败，请从备份恢复：${LAST_BACKUP}"
    systemctl restart "$SERVICE_NAME" || true
    [[ "$backend" == "none" ]] || warn "新端口防火墙规则已保留，请确认是否需要手动删除。"
    die "端口修改失败，已恢复旧配置。"
  fi

  install -d -o root -g root -m 0755 "$STATE_DIR"
  printf '%s\n' "$new_port" > "$PORT_STATE"
  chmod 0644 "$PORT_STATE"
  # Keep the old allow rule: it may predate this tool or be shared by another service.
  [[ "$backend" == "none" ]] || warn "旧端口的放行规则已保留，确认无其他用途后可手动删除。"
  release_lock
  ok "端口已从 ${old_port} 修改为 ${new_port}。"
  show_connection
}

show_logs() {
  journalctl -u "$SERVICE_NAME" -n 80 --no-pager
}

toggle_timer() {
  acquire_lock
  if systemctl is-active --quiet "$TIMER_NAME"; then
    warn "自动升级当前已启用。"
    confirm "确认关闭每日自动升级检查？" || {
      info "已取消。"
      release_lock
      return 0
    }
    systemctl disable --now "$TIMER_NAME" || die "关闭自动升级失败。"
    ok "自动升级已关闭。"
  else
    systemctl enable --now "$TIMER_NAME" || die "开启自动升级失败。"
    ok "自动升级已启用。"
    systemctl list-timers "$TIMER_NAME" --no-pager || true
  fi
  release_lock
}

show_or_set_channel() {
  [[ -x "$MANAGER_PATH" ]] || die "未找到 ${MANAGER_PATH}。"
  "$MANAGER_PATH" channel "$@"
}

choose_channel() {
  local choice=""
  show_or_set_channel
  printf '\n1) stable：只自动安装正式版（推荐）\n2) prerelease：也自动安装 beta/rc\n0) 不修改\n'
  read -r -p "请选择 [0]: " choice
  case "${choice:-0}" in
    1) show_or_set_channel stable ;;
    2)
      warn "Snell 预发布版曾改变协议，自动升级后可能需要同步升级 Surge。"
      confirm "确认让自动升级安装 beta/rc？" && show_or_set_channel prerelease
      ;;
    0) info "未修改。" ;;
    *) die "无效选择。" ;;
  esac
}

owned_tool() {
  local target="$1" marker="$2"
  [[ -f "$target" && ! -L "$target" ]] && grep -Fq "$marker" "$target"
}

# Undo in reverse order of installation: hardening, network, Snell, tools.
uninstall_all() {
  local purge=0 assume_yes=0 arg target
  for arg in "$@"; do
    case "$arg" in
      --purge) purge=1 ;;
      --yes|-y) assume_yes=1 ;;
      *) die "uninstall 只接受 --purge 和 --yes。" ;;
    esac
  done
  warn "将依次：回滚安全加固 → 回滚网络参数 → 卸载 Snell 服务 → 删除 snellx 等管理工具。"
  if (( purge )); then
    warn "--purge 会同时删除配置、PSK、状态与备份；之后无法用原 PSK 恢复。"
  else
    info "配置和 PSK 将保留在 /etc/snell-server，可再次安装恢复。"
  fi
  if (( ! assume_yes )); then
    confirm "确认卸载？" || { info "已取消。"; return 0; }
  fi

  if [[ -d "${SECURITY_STATE}/baseline" ]]; then
    [[ -x "$SECURITY_TOOL" ]] || die "存在安全加固基线但缺少 ${SECURITY_TOOL}，已停止卸载。"
    "$SECURITY_TOOL" rollback || die "安全配置回滚失败，已停止卸载；处理上方提示后重新运行 snellx uninstall。"
  fi
  if [[ -d "${NETWORK_STATE}/baseline" ]]; then
    [[ -x "$NETWORK_TOOL" ]] || die "存在网络参数基线但缺少 ${NETWORK_TOOL}，已停止卸载。"
    "$NETWORK_TOOL" rollback || die "网络参数回滚失败，已停止卸载；处理上方提示后重新运行 snellx uninstall。"
  fi
  if [[ -x "$MANAGER_PATH" ]]; then
    if (( purge )); then "$MANAGER_PATH" uninstall --purge; else "$MANAGER_PATH" uninstall; fi ||
      die "Snell 卸载失败，管理工具已保留以便重试。"
  fi

  owned_tool "$NETWORK_TOOL" 'zzzz-snell-auto-network.conf' && rm -f -- "$NETWORK_TOOL"
  owned_tool "$SECURITY_TOOL" 'Managed by snell-security' && rm -f -- "$SECURITY_TOOL"
  owned_tool "$AUTO_TOOL" '# snell-auto: self-contained Linux Snell v6 installer' && rm -f -- "$AUTO_TOOL"
  if (( purge )); then
    for target in "$NETWORK_STATE" "$SECURITY_STATE"; do
      [[ -d "$target" && ! -L "$target" ]] && rm -rf -- "$target"
    done
    if id -u snell >/dev/null 2>&1 && ! pgrep -u snell >/dev/null 2>&1; then
      userdel snell >/dev/null 2>&1 || warn "未能删除系统用户 snell，可稍后手动 userdel snell。"
    fi
  fi
  # Unlinking the running script is safe: Bash keeps the open file.
  for target in /usr/local/bin/snellx /usr/local/sbin/snellx; do
    owned_tool "$target" "$MENU_MARKER" && rm -f -- "$target"
  done
  ok "卸载完成。防火墙中为 Snell 放行的端口规则未删除，确认不再使用后可手动删除。"
}

network_command() {
  [[ -x "$NETWORK_TOOL" ]] || die "未安装网络模块，请先运行 snell-auto.sh。"
  "$NETWORK_TOOL" "$@"
}

optimize_network() {
  network_command apply || return 1
  info "网络参数已检查。已有连接可能继续使用旧参数；新连接生效，必要时选择重启 Snell。"
}

security_command() {
  [[ -x "$SECURITY_TOOL" ]] || die "未安装安全模块，请重新运行新版 snell-auto.sh。"
  "$SECURITY_TOOL" "$@"
}

health_check() {
  local port
  local failed=0
  port="$(current_port || true)"

  printf '%sSnell v6 健康检查%s\n' "$C_BOLD" "$C_RESET"
  if systemctl is-active --quiet "$SERVICE_NAME"; then
    ok "服务运行中"
  else
    warn "服务未运行"
    failed=1
  fi

  if [[ -n "$port" ]] && port_is_listening "$port"; then
    ok "TCP ${port} 正在监听"
  else
    warn "未检测到 Snell 监听端口"
    failed=1
  fi

  if systemctl is-active --quiet "$TIMER_NAME"; then
    ok "自动升级定时器运行中"
  else
    warn "自动升级定时器未运行"
  fi

  case "$(firewall_backend)" in
    ufw)
      if grep -Eq "^${port}/tcp[[:space:]]+ALLOW" <<< "$(ufw status 2>/dev/null)"; then
        ok "UFW 已放行 TCP ${port}"
      else
        warn "UFW 未发现 TCP ${port} 放行规则"
        failed=1
      fi
      ;;
    firewalld)
      if firewall-cmd --query-port="${port}/tcp" >/dev/null 2>&1; then
        ok "firewalld 已放行 TCP ${port}"
      else
        warn "firewalld 未放行 TCP ${port}"
        failed=1
      fi
      ;;
  esac

  if [[ "$failed" -eq 0 ]]; then
    ok "检查通过。"
  else
    return 1
  fi
}

print_menu() {
  clear 2>/dev/null || true
  printf '%s\n' "${C_BOLD}Snell v6 管理工具（snellx）${C_RESET}"
  printf '%s\n' "──────────────────────────────"
  printf '  1) 查看运行状态\n'
  printf '  2) 查看连接配置（含 PSK）\n'
  printf '  3) 检查并更新 Snell\n'
  printf '  4) 重启 Snell\n'
  printf '  5) 修改/随机生成 PSK\n'
  printf '  6) 修改/随机生成端口\n'
  printf '  7) 查看最近日志\n'
  printf '  8) 开启/关闭自动升级\n'
  printf '  9) 一键健康检查\n'
  printf '  10) 检测系统与网络环境\n'
  printf '  11) 应用自适应网络参数\n'
  printf '  12) 回滚本工具的网络参数\n'
  printf '  13) 查看安全加固状态\n'
  printf '  14) 应用基础安全加固\n'
  printf '  15) 回滚本工具的安全配置\n'
  printf '  16) 自动升级通道（正式版/预发布版）\n'
  printf '  17) 完全卸载（先回滚加固和网络参数）\n'
  printf '  0) 退出\n'
  printf '%s\n' "──────────────────────────────"
}

# Each action runs in its own subshell with errexit on, so die/exit inside an
# action (bad input, failed restart) returns to the menu instead of closing it.
# A lock taken by the action is released when its subshell exits.
run_menu_action() {
  local status
  set +e
  ( set -e; "$@" )
  status=$?
  set -e
  if (( status != 0 )); then warn "操作未完成（退出码 ${status}），已返回菜单。"; fi
  return 0
}

interactive_menu() {
  local choice
  while true; do
    print_menu
    read -r -p "请选择 [0-17]: " choice || return 0
    choice="${choice//[[:space:]]/}"
    printf '\n'
    case "$choice" in
      1) run_menu_action require_installation_then show_status ;;
      2) run_menu_action require_installation_then show_connection ;;
      3) run_menu_action require_installation_then update_snell ;;
      4) run_menu_action require_installation_then restart_snell ;;
      5) run_menu_action require_installation_then change_psk ;;
      6) run_menu_action require_installation_then change_port ;;
      7) run_menu_action show_logs ;;
      8) run_menu_action require_installation_then toggle_timer ;;
      9) run_menu_action require_installation_then health_check ;;
      10) run_menu_action network_command diagnose ;;
      11) run_menu_action optimize_network ;;
      12) run_menu_action network_command rollback ;;
      13) run_menu_action security_command status ;;
      14) run_menu_action security_command apply ;;
      15) run_menu_action security_command rollback ;;
      16) run_menu_action require_installation_then choose_channel ;;
      17)
        run_menu_action uninstall_all
        [[ -e /usr/local/sbin/snellx ]] || return 0
        ;;
      0) printf '再见。\n'; return 0 ;;
      *) warn "无效选择：${choice}" ;;
    esac
    pause_screen
  done
}

usage() {
  cat <<'EOF'
用法：
  snellx                 打开交互式菜单
  snellx status          查看状态
  snellx show            显示连接配置（包含 PSK）
  snellx update          检查并更新 Snell
  snellx restart         重启服务
  snellx psk             修改/生成 PSK
  snellx port            修改/生成端口
  snellx logs            查看最近日志
  snellx timer           开启/关闭自动升级
  snellx channel [stable|prerelease] 查看/设置自动升级通道
  snellx check           一键健康检查
  snellx diagnose        检测系统/网络（可追加 --probe IP）
  snellx optimize        应用保守的自适应网络参数
  snellx rollback-network 恢复本工具首次优化前的参数
  snellx security [--no-packages] 应用基础安全加固
  snellx security-status 查看安全加固状态
  snellx rollback-security 回滚本工具的安全配置
  snellx uninstall [--purge] [--yes] 回滚加固/网络参数后卸载全部组件
EOF
}

require_installation_then() {
  require_installation
  "$@"
}

main() {
  require_root
  require_systemd

  # Rollback, diagnostics and uninstall must keep working after Snell itself
  # has been removed; only Snell-specific commands need a full installation.
  case "${1:-menu}" in
    menu) interactive_menu ;;
    status) require_installation; show_status ;;
    show) require_installation; show_connection ;;
    update) require_installation; update_snell ;;
    restart) require_installation; restart_snell ;;
    psk) require_installation; change_psk ;;
    port) require_installation; change_port ;;
    logs) show_logs ;;
    timer) require_installation; toggle_timer ;;
    channel) shift; require_installation; show_or_set_channel "$@" ;;
    check) require_installation; health_check ;;
    uninstall) shift; uninstall_all "$@" ;;
    diagnose) shift; network_command diagnose "$@" ;;
    optimize) optimize_network ;;
    rollback-network) network_command rollback ;;
    security) shift; security_command apply "$@" ;;
    security-status) shift; security_command status "$@" ;;
    rollback-security) shift; security_command rollback "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
